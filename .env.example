# 환경변수 예시

# Backend only (not used on GitHub Pages)
OPENAI_API_KEY=

# Frontend — local development
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_PROXY_MODEL=true
# Prefer path without leading slash; publicUrl + BASE_URL resolve it
VITE_GLTF_MODEL_PATH=models/aircraft_maintenance_demo.glb

# GitHub Pages build only (set by GitHub Actions via configure-pages)
# VITE_BASE_PATH=/<repository-name>/
